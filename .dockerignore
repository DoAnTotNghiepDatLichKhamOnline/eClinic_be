**/node_modules

# Bí mật
.env
.env.*
**/.env
**/seop-providers.json
*.pem
*.key

# Công cụ PM Bible và kế hoạch (không phải mã nguồn)
bible/
.bible/
bible-files/
.claude/
cycles/
temp/

