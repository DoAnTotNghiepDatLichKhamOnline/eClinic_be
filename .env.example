# Copy file này thành .env (đã được .gitignore) rồi chỉnh theo máy của bạn.
# docker-compose.yml và application.yml đều dùng chung các biến này (có giá trị mặc định).
#
# Hai cách chạy (xem đầu file docker-compose.yml):
#   docker compose up -d                          -> chỉ MySQL + Redis + phpMyAdmin, service chạy trong IntelliJ
#   docker compose --profile app up -d --build    -> chạy cả 7 service + api-gateway trong Docker
# Không chạy service trong IntelliJ cùng lúc với cách 2: trùng cổng 8080-8088.

MYSQL_ROOT_PASSWORD=root
# DB_HOST/DB_PORT, REDIS_HOST/REDIS_PORT: dùng khi chạy service trong IntelliJ.
# Với docker compose, DB_PORT/REDIS_PORT chỉ là cổng mở ra máy host; bên trong Docker luôn là mysql:3306, redis:6379.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eclinic
DB_USERNAME=eclinic
DB_PASSWORD=eclinic

REDIS_HOST=localhost
REDIS_PORT=6379

PMA_PORT=8090

# JWT: khoá ký tối thiểu 32 ký tự, phải giống nhau ở mọi service.
# Máy local: ĐỂ NGUYÊN dòng dưới bị comment. Khi đó cả service chạy trong IntelliJ lẫn trong Docker đều dùng
# chung khoá mặc định (application-common.yml, docker-compose.yml), token tạo ở cách chạy này dùng được ở cách kia.
# Chỉ đặt khi triển khai thật; khi đặt thì phải đặt cả trong biến môi trường của run config IntelliJ.
# JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-dai-it-nhat-32-ky-tu
# Tài khoản quản trị tạo sẵn khi identity-service khởi động lần đầu (chưa có admin nào).
# Lấy token để thử API: POST /api/auth/login với email + mật khẩu này (xem README).
ADMIN_EMAIL=admin@eclinic.local
ADMIN_PASSWORD=Admin@123

# Email của identity-service (kích hoạt tài khoản, đặt lại mật khẩu).
#   MAIL_MODE=console (mặc định): KHÔNG gửi email, liên kết được ghi ra log của identity-service -> copy để thử.
#   MAIL_MODE=smtp: gửi thật qua Gmail. MAIL_APP_PASSWORD là App Password 16 ký tự, KHÔNG phải mật khẩu Gmail:
#     bật Xác minh 2 bước cho tài khoản Google rồi tạo ở https://myaccount.google.com/apppasswords
#   Thiếu MAIL_USERNAME / MAIL_APP_PASSWORD khi MAIL_MODE=smtp thì identity-service không khởi động.
# MAIL_MODE=smtp
# MAIL_USERNAME=ten-ban@gmail.com
# MAIL_APP_PASSWORD=abcdefghijklmnop
# Liên kết trong email trỏ về frontend (vd http://localhost:5173/verify-email?token=...)
FRONTEND_URL=http://localhost:5173

# Đăng nhập bằng Google: OAuth Client ID loại "Web application" (Google Cloud Console > APIs & Services > Credentials),
# frontend dùng cùng Client ID này với Google Identity Services. Để trống thì POST /api/auth/google trả 503.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Refresh token nằm trong cookie HttpOnly, Secure. Trình duyệt (Chrome/Edge/Firefox) và curl coi http://localhost là an toàn
# nên để mặc định. Chỉ đặt false khi mở frontend qua IP mạng LAN bằng http (vd http://192.168.1.5:5173).
# COOKIE_SECURE=false

# api-gateway: địa chỉ frontend được phép gọi API (CORS), phân cách bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
