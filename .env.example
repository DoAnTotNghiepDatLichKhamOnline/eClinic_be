# Copy file này thành .env (đã được .gitignore) rồi chỉnh theo máy của bạn.
# docker-compose.yml và application.yml đều dùng chung các biến này (có giá trị mặc định).
#
# Hai cách chạy (xem đầu file docker-compose.yml):
#   docker compose up -d                          -> chỉ MySQL + Redis + phpMyAdmin, service chạy trong IntelliJ
#   docker compose --profile app up -d --build    -> chạy cả 7 service + api-gateway trong Docker
# Không chạy service trong IntelliJ cùng lúc với cách 2: trùng cổng 8080-8088.
# Service chạy trong IntelliJ cũng đọc file này (run config có sẵn đặt thư mục làm việc là thư mục gốc dự án); biến môi
# trường đặt trong run config được ưu tiên hơn. Ghi giá trị trơn, không có dấu nháy: KEY=gia-tri.

MYSQL_ROOT_PASSWORD=root
# DB_HOST/DB_PORT, REDIS_HOST/REDIS_PORT: dùng khi chạy service trong IntelliJ.
# Với docker compose, DB_PORT/REDIS_PORT chỉ là cổng mở ra máy host; bên trong Docker luôn là mysql:3306, redis:6379.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eclinic
DB_USERNAME=eclinic
DB_PASSWORD=eclinic

REDIS_HOST=localhost
REDIS_PORT=6379

PMA_PORT=8090

# JWT: khoá ký tối thiểu 32 ký tự, phải giống nhau ở mọi service.
# Máy local: ĐỂ NGUYÊN dòng dưới bị comment. Khi đó cả service chạy trong IntelliJ lẫn trong Docker đều dùng
# chung khoá mặc định (application-common.yml, docker-compose.yml), token tạo ở cách chạy này dùng được ở cách kia.
# Chỉ đặt khi triển khai thật; service chạy trong IntelliJ và trong Docker cùng đọc giá trị ở đây.
# JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-dai-it-nhat-32-ky-tu
# Tài khoản quản trị tạo sẵn khi identity-service khởi động lần đầu (chưa có admin nào).
# Lấy token để thử API: POST /api/auth/login với email + mật khẩu này (xem README).
ADMIN_EMAIL=admin@eclinic.local
ADMIN_PASSWORD=Admin@123

# Dữ liệu mẫu để thử / demo, do identity-service tạo khi khởi động (bật sẵn ở docker compose và run config IntelliJ):
#   8 chuyên khoa + phòng khám, 12 bác sĩ, 6 bệnh nhân, ca làm việc + khung giờ trống cho 14 ngày tới (mỗi ngày tự bổ sung).
#   Bác sĩ:    bacsi01@eclinic.local ... bacsi12@eclinic.local
#   Bệnh nhân: benhnhan01@eclinic.local ... benhnhan04 (đã kích hoạt), benhnhan05 (chưa xác thực email), benhnhan06 (bị vô hiệu hoá)
#   Mọi tài khoản mẫu dùng chung mật khẩu SEED_PASSWORD. Chỉ tạo khi DB chưa có bác sĩ nào, sau đó không tạo lại.
# Triển khai thật: SEED_DATA=false. Run config IntelliJ của identity-service đặt sẵn SEED_DATA=true và được ưu tiên hơn file
# này: muốn tắt khi chạy IntelliJ thì sửa trong run config.
# SEED_DATA=false
# SEED_PASSWORD=Demo@123

# Email của identity-service (kích hoạt tài khoản, đặt lại / đổi mật khẩu, đổi email, vô hiệu hoá / kích hoạt lại tài khoản).
#   MAIL_MODE=console (mặc định): KHÔNG gửi email, liên kết được ghi ra log của identity-service -> copy để thử.
#   MAIL_MODE=smtp: gửi thật qua Gmail. MAIL_APP_PASSWORD là App Password 16 ký tự, KHÔNG phải mật khẩu Gmail:
#     bật Xác minh 2 bước cho tài khoản Google rồi tạo ở https://myaccount.google.com/apppasswords
#   Thiếu MAIL_USERNAME / MAIL_APP_PASSWORD khi MAIL_MODE=smtp thì identity-service không khởi động.
# MAIL_MODE=smtp
# MAIL_USERNAME=ten-ban@gmail.com
# MAIL_APP_PASSWORD=abcdefghijklmnop
# Liên kết trong email trỏ về frontend (vd http://localhost:5173/verify-email?token=...)
FRONTEND_URL=http://localhost:5173

# Email của notification-service (xác nhận đã nhận yêu cầu đặt lịch / đổi lịch, gửi tới email liên hệ của lịch hẹn).
#   Dùng chung MAIL_MODE / MAIL_USERNAME / MAIL_APP_PASSWORD ở trên. console: người nhận + tiêu đề + link phiếu khám
#   được ghi ra log của notification-service. smtp: gửi thật; gửi lỗi thì tự thử lại (bảng email_gui).
#   NOTIFICATION_MAIL_MODE: chỉ đặt khi muốn notification-service khác chế độ với identity-service.
#   MAIL_HOST / MAIL_PORT / MAIL_SMTP_AUTH / MAIL_SMTP_STARTTLS: chỉ notification-service dùng (identity-service luôn
#   gửi qua Gmail). Mặc định là Gmail; đổi khi muốn xem email trên 1 máy chủ nhận thử, vd Mailpit:
#     docker run -d --name mailpit -p 8025:8025 -p 1025:1025 axllent/mailpit      (xem thư ở http://localhost:8025)
#     NOTIFICATION_MAIL_MODE=smtp, MAIL_HOST=host.docker.internal, MAIL_PORT=1025, MAIL_SMTP_AUTH=false, MAIL_SMTP_STARTTLS=false
# NOTIFICATION_MAIL_MODE=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# Khoảng nghỉ của job gửi email, và các khoảng chờ trước mỗi lần thử lại (thử hết thì bỏ email đó)
# NOTIFICATION_MAIL_INTERVAL=5s
# NOTIFICATION_MAIL_RETRY_WAITS=1m,5m,30m,2h

# Đăng nhập bằng Google: OAuth Client ID loại "Web application" (Google Cloud Console > APIs & Services > Credentials),
# frontend dùng cùng Client ID này với Google Identity Services. Để trống thì POST /api/auth/google trả 503.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Ảnh đại diện lưu ở Cloudinary (gói Free, không cần thẻ: https://cloudinary.com/users/register_free).
# Lấy 3 giá trị ở Cloudinary Console > Settings > API Keys (Cloud name nằm ở đầu trang). API Secret là bí mật: chỉ để trong .env.
# Thiếu 1 trong 3 giá trị: POST /api/users/me/avatar trả 503, các chức năng khác vẫn chạy bình thường.
# Service chạy trong IntelliJ cũng đọc 3 biến này từ đây (identity-service và catalog-service).
# CLOUDINARY_CLOUD_NAME=ten-cloud-cua-ban
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcDEFghiJKLmnoPQRstuVWXyz0
# Mỗi tài khoản 1 ảnh: <CLOUDINARY_FOLDER>/avatar/<id tài khoản>. Nhiều người dùng chung 1 tài khoản Cloudinary với DB riêng
# thì mỗi người đặt 1 thư mục khác nhau, nếu không sẽ ghi đè ảnh của nhau.
# CLOUDINARY_FOLDER=eclinic
# catalog-service dùng chung 4 biến trên cho ảnh giới thiệu bác sĩ: <CLOUDINARY_FOLDER>/bac-si/<id bác sĩ>/<mã ngẫu nhiên>.
# Thiếu 1 trong 3 giá trị đầu: POST /api/catalog/quan-tri/bac-si/{id}/anh trả 503.

# Refresh token nằm trong cookie HttpOnly, Secure. Trình duyệt (Chrome/Edge/Firefox) và curl coi http://localhost là an toàn
# nên để mặc định. Chỉ đặt false khi mở frontend qua IP mạng LAN bằng http (vd http://192.168.1.5:5173).
# COOKIE_SECURE=false

# api-gateway: địa chỉ frontend được phép gọi API (CORS), phân cách bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# api-gateway: body request tối đa (vượt -> 413 YEU_CAU_QUA_LON). Phải nhỏ hơn 10MB (max-swallow-size của identity-service).
# GATEWAY_MAX_REQUEST_SIZE=5MB
# api-gateway: thời gian chờ service trả lời (quá hạn -> 504).
# GATEWAY_READ_TIMEOUT=30s
# api-gateway: regex địa chỉ các proxy đứng TRƯỚC gateway được tin khi ghi X-Forwarded-For (địa chỉ client mà booking-service
# dùng để giới hạn số lần đặt lịch theo IP). Mặc định tin tất cả, đủ dùng khi client gọi thẳng gateway. Triển khai thật
# sau reverse proxy (nginx...): xem docs/BAO-MAT-XAC-THUC.md mục 7 trước khi đổi.
# GATEWAY_TRUSTED_PROXIES=.*

# booking-service: giới hạn khi đặt lịch khám (POST /api/booking/lich-hen không cần đăng nhập nên phải có giới hạn).
#   BOOKING_MIN_LEAD: lượt khám chỉ đặt được khi còn cách giờ bắt đầu ít nhất khoảng này (30m, 1h...).
#   BOOKING_MAX_DAYS: chỉ đặt được lịch trong số ngày tới này, tính cả hôm nay.
#   BOOKING_MAX_ACTIVE_PER_PATIENT / _PER_PHONE: số lịch hẹn sắp tới còn hiệu lực tối đa của 1 hồ sơ bệnh nhân / 1 SĐT liên hệ.
#   BOOKING_IP_LIMIT lần gọi đặt lịch từ 1 địa chỉ IP trong BOOKING_IP_WINDOW (đếm trên Redis; Redis lỗi thì bỏ qua giới hạn này).
#   BOOKING_CHANGE_LEAD: bệnh nhân chỉ hủy / đổi được lịch khi còn cách giờ khám ít nhất khoảng này (2h, 24h...).
#   BOOKING_MAX_RESCHEDULES: số lần đổi lịch tối đa của 1 lần đặt.
# BOOKING_MIN_LEAD=30m
# BOOKING_MAX_DAYS=30
# BOOKING_MAX_ACTIVE_PER_PATIENT=3
# BOOKING_MAX_ACTIVE_PER_PHONE=5
# BOOKING_IP_LIMIT=20
# BOOKING_IP_WINDOW=10m
# BOOKING_CHANGE_LEAD=2h
# BOOKING_MAX_RESCHEDULES=2

# booking-service: ca làm việc.
#   SHIFT_REQUEST_LEAD: bác sĩ chỉ gửi được yêu cầu đổi ca / xin nghỉ khi ca còn cách giờ bắt đầu ít nhất khoảng này.
#   SHIFT_MAX_DAYS: quản trị viên chỉ xếp được ca trong số ngày tới này (xa hơn BOOKING_MAX_DAYS: xếp ca trước, bệnh
#     nhân đặt được khi ca vào trong hạn đặt lịch).
#   SHIFT_MAX_WEEKLY_HOURS: tổng giờ các ca của 1 bác sĩ trong 1 tuần (thứ Hai - Chủ nhật) không vượt số giờ này (SCHED-05).
#   DOCTOR_SCHEDULE_PATH: trang Lịch làm việc của bác sĩ trên frontend; nút trong email "gửi lịch" mở FRONTEND_URL + đường dẫn này.
# SHIFT_REQUEST_LEAD=24h
# SHIFT_MAX_DAYS=90
# SHIFT_MAX_WEEKLY_HOURS=48
# DOCTOR_SCHEDULE_PATH=/doctor/work-schedule

# Hồ sơ bệnh án (medical-service chặn sửa, booking-service trả hạn sửa cho bác sĩ: đặt cùng 1 giá trị cho cả 2).
#   RECORD_EDIT_DAYS: bác sĩ sửa được hồ sơ bệnh án trong số ngày này kể từ lần lưu đầu tiên (mỗi lần sửa cần lý do),
#     sau đó hồ sơ chỉ xem được.
# RECORD_EDIT_DAYS=7

# Quản lý bác sĩ (quản trị viên thêm bác sĩ, cho ngừng công tác).
#   DOCTOR_DEFAULT_PASSWORD: mật khẩu ban đầu của tài khoản bác sĩ mới (identity-service). Bác sĩ phải đặt mật khẩu của
#     mình ở lần đăng nhập đầu; mật khẩu này không mở được phiên đăng nhập. Tối thiểu 6 ký tự. Nên đổi khi triển khai thật.
#   IDENTITY_URL, BOOKING_URL: địa chỉ 2 service mà catalog-service gọi API nội bộ /noi-bo/** (chạy IntelliJ:
#     http://localhost:8081 và http://localhost:8084; docker compose tự đặt theo tên service).
# DOCTOR_DEFAULT_PASSWORD=Doctor@123
# IDENTITY_URL=http://localhost:8081
# BOOKING_URL=http://localhost:8084

# Thông báo trong ứng dụng (chuông): booking-service ghi sự kiện vào bảng su_kien_thong_bao, một job gửi sang
# notification-service qua API nội bộ POST /noi-bo/thong-bao (không qua gateway).
#   INTERNAL_API_KEY: khoá của các API nội bộ giữa các service (header X-Khoa-Noi-Bo), tối thiểu 32 ký tự, giống nhau ở
#     mọi service. Giá trị mặc định chỉ để chạy máy local; triển khai thật phải đặt giá trị riêng.
#   NOTIFICATION_URL: địa chỉ notification-service mà booking-service gọi (chạy IntelliJ: http://localhost:8086;
#     docker compose tự đặt http://notification-service:8086).
#   BOOKING_NOTIFY_INTERVAL: khoảng nghỉ giữa 2 lần gửi, cũng là độ trễ tối đa của 1 thông báo (5s, 30s...).
# INTERNAL_API_KEY=
# NOTIFICATION_URL=http://localhost:8086
# BOOKING_NOTIFY_INTERVAL=5s

# Nhắc lịch khám (booking-service): thông báo cho tài khoản phía bệnh nhân + email cho người đặt, trước giờ khám.
#   BOOKING_REMINDER_BEFORE: các mốc nhắc, cách nhau bằng dấu phẩy (3d,1d = trước 3 ngày và trước 1 ngày).
#     Lịch đặt khi đã ở trong khoảng của 1 mốc thì bỏ mốc đó (đặt hôm nay cho ngày mai: chỉ có email xác nhận).
#   BOOKING_REMINDER_INTERVAL: khoảng nghỉ giữa 2 lần tìm lịch hẹn đến hạn nhắc.
#   BOOKING_REMINDER_FROM / BOOKING_REMINDER_TO: chỉ nhắc trong khoảng giờ này; đến hạn ban đêm thì sáng hôm sau nhắc.
#   BOOKING_REMINDER_MIN_LEAD: lượt khám còn cách ít hơn khoảng này thì không nhắc nữa.
# BOOKING_REMINDER_BEFORE=3d,1d
# BOOKING_REMINDER_INTERVAL=5m
# BOOKING_REMINDER_FROM=07:00
# BOOKING_REMINDER_TO=21:00
# BOOKING_REMINDER_MIN_LEAD=2h

# Nhắc tái khám (booking-service): bác sĩ ghi / đổi "ngày tái khám đề xuất" thì bệnh nhân nhận thông báo + email (chậm
# nhất sau BOOKING_REMINDER_INTERVAL, trong khoảng giờ BOOKING_REMINDER_FROM / TO), và được nhắc lại trước ngày đó.
# Chỉ báo và nhắc, KHÔNG tự tạo lịch hẹn. Bác sĩ xoá ngày tái khám thì không nhắc nữa.
#   FOLLOWUP_REMINDER_DAYS: nhắc trước ngày tái khám bao nhiêu ngày (0 = không nhắc trước). Ngày hẹn gần hơn số này
#     thì chỉ có lời báo lúc hẹn. Bệnh nhân đã có lịch hẹn sắp tới với bác sĩ cùng chuyên khoa thì không nhắc.
#   FOLLOWUP_BOOKING_PATH: trang đặt lịch của frontend; nút trong email mở FRONTEND_URL + đường dẫn này.
# FOLLOWUP_REMINDER_DAYS=7
# FOLLOWUP_BOOKING_PATH=/dat-lich

# ---------- Chatbot (chatbot-service) ----------
# Trợ lý AI: hướng dẫn dùng trang và trả lời câu hỏi sức khỏe thông thường. Mô hình ngôn ngữ được gọi qua API kiểu OpenAI
# (POST <CHATBOT_BASE_URL>/chat/completions, khoá ở header Authorization: Bearer) nên đổi nhà cung cấp chỉ cần đổi 3 biến đầu.
#   CHATBOT_API_KEY: để trống = chatbot tắt (mở phiên vẫn được, gửi tin nhắn trả 503 CHATBOT_KHONG_KHA_DUNG).
#     Gemini: tạo khoá miễn phí ở https://aistudio.google.com/apikey . Ở gói miễn phí, Google dùng nội dung gửi lên để
#     cải thiện sản phẩm của họ và hạn mức tính theo project: đừng gửi dữ liệu thật của bệnh nhân bằng khoá miễn phí.
#   CHATBOT_MODEL: tên mô hình của nhà cung cấp (xem danh sách hiện có ở https://ai.google.dev/gemini-api/docs/models).
#   CHATBOT_REASONING_EFFORT: minimal / low / medium / high; để trống (CHATBOT_REASONING_EFFORT=) nếu nhà cung cấp không nhận.
#   Giới hạn (đếm trên Redis; Redis lỗi thì bỏ qua), theo tài khoản khi đã đăng nhập, theo địa chỉ IP với khách:
#     CHATBOT_LIMIT_MESSAGES tin nhắn trong CHATBOT_LIMIT_WINDOW, CHATBOT_LIMIT_DAILY tin nhắn trong 24 giờ,
#     CHATBOT_LIMIT_SESSIONS phiên chat mở trong 1 giờ; CHATBOT_LIMIT_TOTAL_DAILY lần gọi mô hình của cả hệ thống trong 24 giờ.
# CHATBOT_API_KEY=
# CHATBOT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CHATBOT_MODEL=gemini-3.8-flash
# CHATBOT_REASONING_EFFORT=low
# CHATBOT_TIMEOUT=20s
# 1 tin nhắn có thể gọi mô hình vài lần (mô hình xin tra cứu bác sĩ / lịch khám): tổng thời gian và số lần gọi tối đa.
# CHATBOT_TOTAL_TIMEOUT phải nhỏ hơn GATEWAY_READ_TIMEOUT. chatbot-service đọc bác sĩ, lịch khám qua API công khai của
# catalog-service và booking-service ở CATALOG_URL, BOOKING_URL (chạy IntelliJ: mặc định localhost:8082, localhost:8084).
# CHATBOT_TOTAL_TIMEOUT=27s
# CHATBOT_MAX_MODEL_CALLS=3
# CHATBOT_PERSONAL_DATA=false: chatbot không đọc lịch hẹn, lượt khám của bệnh nhân đang chat. Khi bật (mặc định), bệnh nhân
# phải đồng ý trong từng phiên chat; chỉ ngày giờ, bác sĩ, chuyên khoa, phòng, trạng thái, ngày tái khám được gửi cho mô hình.
# CHATBOT_PERSONAL_DATA=true
# CHATBOT_MAX_TOKENS=2048
# CHATBOT_LIMIT_MESSAGES=20
# CHATBOT_LIMIT_WINDOW=10m
# CHATBOT_LIMIT_DAILY=100
# CHATBOT_LIMIT_SESSIONS=10
# CHATBOT_LIMIT_TOTAL_DAILY=1000
