# Copy thành .env. Comment chỉ đặt trên dòng riêng (IntelliJ đọc file này như .properties). Dòng bị comment là giá trị ví dụ, không đặt thì dùng mặc định của service.

# ---- Cơ sở dữ liệu, Redis ----
MYSQL_ROOT_PASSWORD=root
# DB_HOST/DB_PORT, REDIS_HOST/REDIS_PORT: cho service chạy trong IntelliJ; trong Docker là cổng mở ra máy host
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eclinic
DB_USERNAME=eclinic
DB_PASSWORD=eclinic
REDIS_HOST=localhost
REDIS_PORT=6379
PMA_PORT=8090

# ---- Bảo mật ----
# Khoá ký JWT, tối thiểu 32 ký tự, giống nhau ở mọi service; chỉ đặt khi triển khai thật
# JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-dai-it-nhat-32-ky-tu
# JWT_TTL=30m
# Khoá API nội bộ giữa các service (header X-Khoa-Noi-Bo), tối thiểu 32 ký tự; bắt buộc đặt khi triển khai thật
# INTERNAL_API_KEY=
# Đặt false chỉ khi mở frontend qua http bằng IP mạng LAN
# COOKIE_SECURE=false

# ---- Tài khoản tạo sẵn, dữ liệu mẫu ----
ADMIN_EMAIL=admin@eclinic.local
ADMIN_PASSWORD=Admin@123
# Dữ liệu mẫu (bác sĩ, bệnh nhân, ca làm việc) chỉ tạo khi DB chưa có bác sĩ
# SEED_DATA=false
# SEED_VOLUME=false
# SEED_PASSWORD=Demo@123
# DOCTOR_DEFAULT_PASSWORD=Doctor@123

# ---- URL ----
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Tên miền của API, chỉ dùng cho Caddy ở docker-compose.prod.yml
# API_DOMAIN=eclinic-api.duckdns.org
# Token của Cloudflare named tunnel, chỉ dùng cho bản dự phòng trên laptop (docker-compose.backup.yml)
# CF_TUNNEL_TOKEN=
# Tên miền đã gắn cho named tunnel trong Cloudflare (vd. api-backup.example.com), để script in và kiểm tra URL
# CF_TUNNEL_HOSTNAME=
# VM và khoá SSH để deploy/backup-restore.ps1 -Pull lấy bản dump mới nhất (khoá mặc định ~/.ssh/eclinic_gcp)
# BACKUP_VM_HOST=
# BACKUP_SSH_KEY=
# Địa chỉ service khác khi chạy IntelliJ; docker compose tự đặt theo tên service
# IDENTITY_URL=http://localhost:8081
# BOOKING_URL=http://localhost:8084
# NOTIFICATION_URL=http://localhost:8086

# ---- Email ----
# console = ghi liên kết ra log; smtp = gửi thật qua Gmail (MAIL_APP_PASSWORD là App Password 16 ký tự)
# MAIL_MODE=smtp
# MAIL_USERNAME=ten-ban@gmail.com
# MAIL_APP_PASSWORD=abcdefghijklmnop
# Chỉ notification-service dùng; đổi để gửi sang máy chủ thử như Mailpit
# NOTIFICATION_MAIL_MODE=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# NOTIFICATION_MAIL_INTERVAL=5s
# NOTIFICATION_MAIL_RETRY_WAITS=1m,5m,30m,2h
# NOTIFICATION_MAIL_CLEANUP_CRON=0 40 3 * * *

# ---- Dịch vụ bên ngoài ----
# OAuth Client ID loại Web application; để trống thì POST /api/auth/google trả 503
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Cloudinary (ảnh đại diện, ảnh bác sĩ); thiếu 1 trong 3 khoá thì API tải ảnh trả 503
# CLOUDINARY_CLOUD_NAME=ten-cloud-cua-ban
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcDEFghiJKLmnoPQRstuVWXyz0
# CLOUDINARY_FOLDER=eclinic

# ---- api-gateway ----
# GATEWAY_MAX_REQUEST_SIZE=5MB
# GATEWAY_READ_TIMEOUT=30s
# Số request tối đa của 1 IP trong 1 phút; kiểm tra tải thì đặt rất lớn
# GATEWAY_RATE_LIMIT=300
# GATEWAY_AUTH_RATE_LIMIT=20
# GATEWAY_CHATBOT_RATE_LIMIT=30
# GATEWAY_TRUSTED_PROXIES=.*

# ---- booking-service ----
# Giá trị ban đầu của bảng cau_hinh_he_thong; sau lần chạy đầu sửa ở /api/booking/quan-tri/cau-hinh
# BOOKING_MIN_LEAD=30m
# BOOKING_MAX_DAYS=30
# BOOKING_MAX_ACTIVE_PER_PATIENT=3
# BOOKING_MAX_ACTIVE_PER_PHONE=5
# BOOKING_CHANGE_LEAD=2h
# BOOKING_MAX_RESCHEDULES=2
# SHIFT_REQUEST_LEAD=24h
# SHIFT_MAX_DAYS=90
# SHIFT_MAX_WEEKLY_HOURS=48
# BOOKING_IP_LIMIT=20
# BOOKING_IP_WINDOW=10m
# RELINK_CODE_LIMIT=3
# RELINK_IP_LIMIT=10
# RELINK_WINDOW=1h
# DOCTOR_SCHEDULE_PATH=/doctor/work-schedule
# BOOKING_NOTIFY_INTERVAL=5s
# BOOKING_NOTIFY_CLEANUP_CRON=0 30 3 * * *
# BOOKING_REMINDER_BEFORE=3d,1d
# BOOKING_REMINDER_INTERVAL=5m
# BOOKING_REMINDER_FROM=07:00
# BOOKING_REMINDER_TO=21:00
# BOOKING_REMINDER_MIN_LEAD=2h
# FOLLOWUP_REMINDER_DAYS=7
# FOLLOWUP_BOOKING_PATH=/dat-lich

# ---- medical-service ----
# Số ngày bác sĩ được sửa hồ sơ bệnh án; booking-service đọc cùng giá trị
# RECORD_EDIT_DAYS=7

# ---- chatbot-service ----
# API kiểu OpenAI; để trống CHATBOT_API_KEY thì chatbot tắt
# CHATBOT_API_KEY=
# CHATBOT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CHATBOT_MODEL=gemini-3.8-flash
# CHATBOT_REASONING_EFFORT=low
# CHATBOT_TIMEOUT=20s
# CHATBOT_TOTAL_TIMEOUT=27s
# CHATBOT_MAX_MODEL_CALLS=3
# CHATBOT_MAX_TOKENS=2048
# CHATBOT_PERSONAL_DATA=true
# CHATBOT_LIMIT_MESSAGES=20
# CHATBOT_LIMIT_WINDOW=10m
# CHATBOT_LIMIT_DAILY=100
# CHATBOT_LIMIT_SESSIONS=10
# CHATBOT_LIMIT_TOTAL_DAILY=1000
